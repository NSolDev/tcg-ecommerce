# ==========================================================================
# TCG Store — variables de entorno (ejemplo)
# Copia este archivo a `.env` y reemplaza los valores. NUNCA subas `.env`.
# Todos los valores aquí son de ejemplo/ficticios.
# ==========================================================================

# --- Requeridas ---------------------------------------------------------

# Base de datos PostgreSQL (Prisma).
# En local sin Docker: apunta a tu Postgres. Con Docker Compose, DATABASE_URL
# se construye automáticamente a partir de las variables POSTGRES_* de abajo.
DATABASE_URL="postgresql://postgres:changeme@localhost:5432/tcg_ecommerce"

# Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Genera uno propio: `openssl rand -base64 32`. Obligatorio: la app no arranca sin él.
NEXTAUTH_SECRET="genera-un-secreto-aleatorio-de-32-bytes"

# --- Docker Compose (requeridas al usar `docker compose`) ---------------
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="cambia-esta-password"
POSTGRES_DB="tcg_ecommerce"

# --- Opcionales ---------------------------------------------------------

# OAuth (opcional). Si se dejan vacías, solo funciona el login por email/contraseña.
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe en modo TEST (opcional). Si se define STRIPE_SECRET_KEY, el checkout usa
# un PaymentIntent real de test; si no, el pago se simula. Sin claves reales aquí.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
